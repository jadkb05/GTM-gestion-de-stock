{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale, dialogues d'ouverture et d'enregistrement. Aucun SQL arbitraire.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-status",
    "allow-list-products",
    "allow-get-product",
    "allow-create-product",
    "allow-update-product",
    "allow-set-product-active",
    "allow-list-product-types",
    "allow-create-product-type",
    "allow-update-product-type",
    "allow-set-product-type-active",
    "allow-list-suppliers",
    "allow-create-supplier",
    "allow-update-supplier",
    "allow-set-supplier-active",
    "allow-list-stock-levels",
    "allow-get-product-stock",
    "allow-record-stock-entry",
    "allow-record-stock-exit",
    "allow-list-stock-movements",
    "allow-get-stock-movement",
    "allow-get-stock-sheet",
    "allow-list-stock-sheet-movements",
    "allow-get-stock-overview",
    "allow-list-inventories",
    "allow-create-inventory",
    "allow-get-inventory",
    "allow-add-inventory-products",
    "allow-save-inventory-counts",
    "allow-check-inventory-drift",
    "allow-refresh-inventory-line",
    "allow-remove-inventory-line",
    "allow-validate-inventory",
    "allow-list-reorder-alerts",
    "allow-set-reorder-threshold",
    "allow-count-reorder-alerts",
    "allow-export-catalogue",
    "allow-export-history",
    "allow-export-inventory",
    "allow-export-reorder-alerts",
    "allow-preview-article-import",
    "allow-commit-article-import",
    "allow-get-backup-status",
    "allow-create-backup",
    "allow-inspect-backup",
    "allow-restore-backup",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
